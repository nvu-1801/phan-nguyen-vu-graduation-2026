APP_ENV_FILE=.env.production
APP_PORT=3000
IMAGE_TAG=production
SITE_ORIGIN=https://invite.example.com
NEXT_PUBLIC_SITE_URL=https://invite.example.com
TRUST_PROXY=1
# Replace on the VPS: openssl rand -hex 32
RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Admin view at /admin. Both values are required to enable sign-in; leave them
# commented out to keep the admin area disabled. Use a unique password of at
# least 16 characters and a separate `openssl rand -hex 32` value for the
# session secret. Keep this file at mode 600 and never commit the real values.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
