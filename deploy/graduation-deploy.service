[Unit]
Description=Graduation 2026 pull-based deploy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=vu
WorkingDirectory=/home/vu/apps/phan-nguyen-vu-graduation-2026
Environment=APP_DIR=/home/vu/apps/phan-nguyen-vu-graduation-2026
Environment=BRANCH=main
Nice=10
ExecStart=/bin/sh /home/vu/apps/phan-nguyen-vu-graduation-2026/scripts/vps-auto-deploy.sh
