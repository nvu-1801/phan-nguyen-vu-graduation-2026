[Unit]
Description=Graduation 2026 daily SQLite backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=vu
WorkingDirectory=/home/vu/apps/phan-nguyen-vu-graduation-2026
Environment=APP_DIR=/home/vu/apps/phan-nguyen-vu-graduation-2026
Nice=10
ExecStart=/bin/sh /home/vu/apps/phan-nguyen-vu-graduation-2026/scripts/vps-backup.sh
