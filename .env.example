DATABASE_URL=file:./data/graduation.db
DATABASE_AUTH_TOKEN=
RATE_LIMIT_SECRET=
# Writes allowed per IP in 10 minutes; default 30. Raise for a shared venue Wi-Fi.
# WRITE_LIMIT_PER_10_MIN=30
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For Vercel use a persistent, dedicated SQLite-compatible database.
# The Turso Cloud marketplace integration supplies these alternative names.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# VPS reverse proxy (exact public origin, no trailing slash)
# SITE_ORIGIN=https://invite.example.com
# TRUST_PROXY=1
